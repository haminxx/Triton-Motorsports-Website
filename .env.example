# Optional: override chat endpoint (defaults to /api/recruitment-chat on same origin)
# NEXT_PUBLIC_CHAT_API_URL=https://us-central1-ucsdxcrs.cloudfunctions.net/recruitmentChat

# NEVER put GEMINI_API_KEY here for the Next.js static export.
# Set it with: firebase functions:secrets:set GEMINI_API_KEY

# Contact form → Web3Forms → your Porkbun org email (forwards to Gmail)
# 1. Go to https://web3forms.com/
# 2. Enter your org address (e.g. contact@yourdomain.com) — NOT only Gmail if you want domain branding
# 3. Copy the Access Key from the confirmation email
# 4. Put it below in `.env.local`, then rebuild + redeploy Firebase
# Access keys are designed to be public (client-side). Do not commit `.env.local`.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional: Google Identity Services client ID for Staff Portal Google sign-in.
# Create an OAuth 2.0 Web client in Google Cloud and add your hosting origin
# (https://ucsdxcrs.web.app) plus http://localhost:3000 to Authorized JavaScript origins.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
