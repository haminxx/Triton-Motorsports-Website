# Copy to .env for local runs — never commit real keys
#
# PASTE SANDBOX STRIPE KEYS
# 1. Secret or restricted key (sk_test_… or rk_test_…):
#    Paste on the STRIPE_SECRET_KEY line in THIS file after you copy it to
#    chat-server/.env. Also paste the same value in Render → Environment.
#    Never put this key in the Next.js site, .env.local, or GitHub.
# 2. Publishable key (pk_test_…):
#    Paste in the project-root .env.local as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
#    Hosted Checkout does not read it. Do not paste the secret key there.
#
# A restricted key (rk_test_) is safer than a secret key (sk_test_).
# Give it Checkout Sessions write + read. Add Invoices write if receipt
# creation returns a permissions error.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave false while you are using sandbox keys. Set true only for live charges.
STRIPE_ALLOW_LIVE=false
# Optional. Defaults to https://ucsdxcrs.web.app when the browser origin is unknown.
# STRIPE_SITE_URL=https://ucsdxcrs.web.app

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=10000

# Google Drive knowledge sync (optional — falls back to knowledge.md)
GOOGLE_DRIVE_FOLDER_ID=1x1aL_4j-xgzGf7idPT1DWSgjzr1GN8CF
# Use ONE of the following (service account is more reliable for folder listing):
GOOGLE_API_KEY=
# Raw JSON or base64-encoded service account key (Render-friendly)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional tuning
# DRIVE_KNOWLEDGE_TTL_MS=600000
# DRIVE_KNOWLEDGE_MAX_CHARS=80000
